# Production environment. Local development uses config.settings.dev by default.
DJANGO_SETTINGS_MODULE=config.settings.prod

# Generate a private key with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Outside Render, specify your deployment hostnames. Render provides
# RENDER_EXTERNAL_HOSTNAME automatically. Add any custom domains here.
DJANGO_ALLOWED_HOSTS=garage.example.com

# Neon connection details. Copy the host only, without a scheme or path.
POSTGRES_DB=neondb
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_DB_PORT=5432
